@model BE_NguyenGiaBao_25DH230123.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #22B872;">Chi tiết đơn hàng #@Model.OrderID</h2>

<dl class="row">
    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@Html.ActionLink(Model.Customer.CustomerName, "Details", "Customers", new { id = Model.CustomerID }, null)</dd>

    <dt class="col-sm-3">Ngày đặt</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Thanh toán</dt>
    <dd class="col-sm-9">@Model.PaymentStatus</dd>

    <dt class="col-sm-3">Địa chỉ giao hàng</dt>
    <dd class="col-sm-9">@Model.AddressDelivery</dd>
</dl>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th style="background-color: #22B872;">Ảnh</th>
                <th style="background-color: #22B872;">Sản phẩm</th>
                <th style="background-color: #22B872;">Đơn giá</th>
                <th style="background-color: #22B872;">Số lượng</th>
                <th style="background-color: #22B872;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(d.Product.ProductImage))
                        {
                            <img src="@Url.Content(d.Product.ProductImage)" alt="@d.Product.ProductName" style="max-height: 60px;" />
                        }
                    </td>
                    <td>@d.Product.ProductName</td>
                    <td>@d.UnitPrice.ToString("N0") đ</td>
                    <td>@d.Quantity</td>
                    <td>@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Tổng cộng</th>
                <th>@Model.TotalAmount.ToString("N0") đ</th>
            </tr>
        </tfoot>
    </table>
</div>

<div class="d-flex gap-2 mt-3">
    @Html.ActionLink("Quay lại đơn hàng", "Index", new { customerId = Model.CustomerID }, new { @class = "btn btn-secondary" })
</div>