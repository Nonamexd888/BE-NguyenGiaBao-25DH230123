@model IEnumerable<BE_NguyenGiaBao_25DH230123.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #22B872;">Danh sách loại game</h2>

<table class="table bg-info col-md-6">
    <tr>
        <th class="col-md-4" style="background-color: #22B872;">
            Tên loại game
        </th>
        <th class="col-lg-4 col-md-2 col-sm-1" style="background-color: #22B872;"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td style="display: flex; gap: 15px;">
                @Html.ActionLink("Cập nhập", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>