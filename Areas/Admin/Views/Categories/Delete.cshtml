@model BE_NguyenGiaBao_25DH230123.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #22B872;">Xóa danh mục</h2>

<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">

        <div class="form-group">
            <div class="col-md-offset-7 col-md-5">
                <h4 style="background-color: #f8d7da; text-align: center;">Bạn thực sự muốn xóa danh mục này à?</h4>
            </div>
        </div>

        <div class="form-group">
            <div class="control-label col-md-2" style="font-weight: bold;">Tên danh mục</div>
            <div class="col-md-10">
                @Html.DisplayFor(model => model.CategoryName)
            </div>
        </div>

        <br />

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-primary btn-sm" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
            </div>
        </div>
    </div>
}