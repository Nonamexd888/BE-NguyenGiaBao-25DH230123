@model BE_NguyenGiaBao_25DH230123.Models.ViewModel.CustomerSearchVM
@using PagedList.Mvc

@{
    ViewBag.Title = "Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #22B872;">Danh sách khách hàng</h2>

@using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-6">
        @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Nhập tên, SĐT, email, địa chỉ hoặc tên đăng nhập" })
    </div>
    <div class="col-md-3">
        <select name="sortOrder" class="form-select">
            <option value="name_asc" @(Model.SortOrder == "name_asc" ? "selected" : "")>Tên A → Z</option>
            <option value="name_desc" @(Model.SortOrder == "name_desc" ? "selected" : "")>Tên Z → A</option>
            <option value="id_asc" @(Model.SortOrder == "id_asc" ? "selected" : "")>Mã KH tăng dần</option>
            <option value="id_desc" @(Model.SortOrder == "id_desc" ? "selected" : "")>Mã KH giảm dần</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
}

@if (Model.Customers != null && Model.Customers.Any())
{
    <p>Tìm thấy <strong>@Model.Customers.TotalItemCount</strong> khách hàng.</p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="background-color: #22B872;">Mã KH</th>
                    <th style="background-color: #22B872;">Họ tên</th>
                    <th style="background-color: #22B872;">Số điện thoại</th>
                    <th style="background-color: #22B872;">Email</th>
                    <th style="background-color: #22B872;">Địa chỉ</th>
                    <th style="background-color: #22B872;">Tên đăng nhập</th>
                    <th style="background-color: #22B872;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Customers)
                {
                    <tr>
                        <td>@item.CustomerID</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerPhone</td>
                        <td>@item.CustomerEmail</td>
                        <td>@item.CustomerAddress</td>
                        <td>@item.Username</td>
                        <td>
                            <div class="d-flex gap-2">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                                @Html.ActionLink("Đơn hàng", "Index", "Orders", new { customerId = item.CustomerID }, new { @class = "btn btn-info btn-sm" })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-container">
        @Html.PagedListPager(Model.Customers, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm,
            sortOrder = Model.SortOrder
        }))
    </div>
}
else
{
    <p>Không tìm thấy khách hàng nào phù hợp.</p>
}