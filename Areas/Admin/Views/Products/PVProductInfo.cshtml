@model BE_NguyenGiaBao_25DH230123.Models.Product

<head>
    <style>
        img {
            max-width: 400px;
        }
    </style>
</head>

<div class="container-fluid">
    <div class="dl-horizontal">
        <div class="row">
            <div class="col-md-4">
                <img src="@Url.Content(Model.ProductImage)" />
            </div>
            <div class="col-md-8 bg-info">
                <dl>
                    <dt>Tên sản phẩm</dt>
                    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt>Mô tả</dt>
                    <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>

                    <dt>Đơn giá</dt>
                    <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

                    <dt>Danh mục</dt>
                    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>