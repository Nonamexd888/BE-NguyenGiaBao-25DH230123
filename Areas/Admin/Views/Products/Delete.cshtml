@model BE_NguyenGiaBao_25DH230123.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Xóa sản phẩm</h2>

<div class="alert-danger">Bạn thực sự muốn xóa danh muc này à?</div>

@Html.Partial("PVProductInfo", Model)

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color">
        <div class="col-md-offset-3 col-md-9">
            @Html.ActionLink("Xóa", "Delete", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })) |
            @Html.ActionLink("Quay lai danh sach", "Index", null, new { @class = "btn btn-primary" })
        </div>
    </div>
}