@model BE_NguyenGiaBao_25DH230123.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .form-actions {
        display: flex;
        gap: 15px;
    }
</style>

<h2 style="background-color: #22B872;">Xóa sản phẩm</h2>

<div class="col-md-4" style="background-color: #f8d7da; text-align: center; font-weight: bold; font-size: 20px;">Bạn thực sự muốn xóa danh mục này à?</div>
<br />

@Html.Partial("PVProductInfo", Model)
<br />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-primary" />
            @Html.ActionLink("Quay lai danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
}