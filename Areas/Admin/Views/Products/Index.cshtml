@model IEnumerable<BE_NguyenGiaBao_25DH230123.Models.Product>

@{
    ViewBag.Title = "Product List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Index</h2>

<h2 class="bg-success">Danh sách game sản phẩm game</h2>

<table class="table bg-info">
    <tr>
        <th class="bg-success col-md-3">Tên sản phẩm</th>
        <th class="bg-success col-md-2">Hình ảnh</th>
        <th class="bg-success col-md-1">Đơn giá</th>
        <th class="bg-success col-md-2">Danh mục</th>
        <th class="bg-success col-md-4"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductImage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductPrice)
            </td>   
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Cập nhập", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" }))
            </td>
        </tr>
    }

</table>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>