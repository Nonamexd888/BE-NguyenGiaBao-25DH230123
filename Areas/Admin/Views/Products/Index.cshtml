@model BE_NguyenGiaBao_25DH230123.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Product List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="background-color: #22B872;">Danh sách game sản phẩm game</h2>

<table class="table bg-info table-responsive">
    <tr>
        <th class="col-md-2" style="background-color: #22B872;">Hình ảnh</th>
        <th class="col-md-3" style="background-color: #22B872;">Tên sản phẩm</th>
        <th class="col-md-1" style="background-color: #22B872;">Đơn giá</th>
        <th class="col-md-2" style="background-color: #22B872;">Danh mục</th>
        <th class="col-md-4" style="background-color: #22B872;"></th>
    </tr>

    @foreach (var item in Model.Products)
    {
        <tr>
            <td> 
                <img src="@Html.DisplayFor(modelItem => item.ProductImage)" /> 
            </td>
            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
            <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
            <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>

            <td>
                @Html.ActionLink("Cập nhập", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<div class="form-group">
    <div class="col-md-offset-3 col-md-9">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>