@model BE_NguyenGiaBao_25DH230123.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Product List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Search</title>
    <style>
        search-container, .order-container {
            padding-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>
<body>
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
               @class = "form-control",
               placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm"
            })

            @Html.TextBoxFor(m => m.MinPrice, new {
            @class = "form-control", placeholder = "Nhập giá tối thiểu", type = "number" })
            @Html.TextBoxFor(m => m.MaxPrice, new {
            @class = "form-control", placeholder = "Nhập giá tối đa", type = "number" })
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
    }
    @Html.Partial("PVListProduct", Model)
</body>
</html>