@{
    // lấy thông tin giỏ hàng
    var cart = Session["Cart"] as BE_NguyenGiaBao_25DH230123.Models.ViewModel.Cart;

    //Tạo đối tượng ViewBag.pmmodel dạng PersonalMenuVM, và lưu trong ViewBag,
    //khởi tạo giá trị dựa trên thông tin tài khoản đăng nhập
    ViewBag.pmmodel = new BE_NguyenGiaBao_25DH230123.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = User.Identity.IsAuthenticated,
        Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty
    };
    //nếu giỏ hàng không rỗng thì gán số lượng mặt hàng trong giỏ cho CartCount
    if (cart != null && cart.Items.Any())
    {
        ViewBag.pmmodel.CartCount = cart.Items.Count();
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Store: @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* Basic styling for the menu */
        ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            display: flex;
        }

        li {
            margin-right: 20px;
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
        }

            .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }
    </style>
</head>
<body>
    <header class="container-fluid" style="background-color: lightgreen;">
        <h4 style="text-align:center; color:green;">
            Free ship đơn từ 40k, giảm nhiều hơn cùng
            <span style="font-weight:bolder; font-style:italic;"><span style="color:blue;">FREESHIP</span> XTRA</span>
        </h4>
    </header>

    <nav class="navbar navbar-expand-sm bg-light border-bottom">
        <div class="container">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand">My Store</a>

            @* MENU CATEGORY: partial view _CategoriesPV, làm sau *@

            <ul class="ms-auto">
                <li>
                    <div style="position:relative;">
                        <i class="fas fa-home"></i>
                        @Html.ActionLink("Trang chủ", "Index", "Home")
                    </div>
                </li>
                <li class="dropdown">
                    <div style="position:relative;">
                        <i class="fas fa-user"></i>
                        <a href="javascript:void(0)" id="account-name">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <text>Hello, </text>@ViewBag.pmmodel.Username
                            }
                            else
                            {
                                <text>Tài khoản</text>
                            }
                        </a>
                        <div class="dropdown-content">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                                <a href="@Url.Action("OrderHistory", "Order")">Lịch sử mua hàng</a>
                                <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                                <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                            }
                        </div>
                    </div>
                </li>
                <li>
                    <div>
                        <a href="@Url.Action("Index2", "Cart")">
                            <i class="fas fa-shopping-cart"></i>
                            (<span id="cart-count">@ViewBag.pmmodel.CartCount</span>)
                        </a>
                    </div>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Gêm - Nguyễn Gia Bảo</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>