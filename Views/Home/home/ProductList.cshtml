@model PagedList.IPagedList<BE_NguyenGiaBao_25DH230123.Models.Product>
@using PagedList.Mvc

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    int categoryId = (int)ViewBag.CategoryId;
}

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<section class="container-fluid listProduct">
    <h2>@ViewBag.CategoryName</h2>

    @if (Model.Any())
    {
        <ul class="list-container">
            @foreach (var product in Model)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@Html.DisplayFor(modelItem => product.ProductPrice)</p>
                        <p class="prodName">@Html.DisplayFor(modelItem => product.ProductName)</p>
                        <p class="prodSale">Đã bán:&nbsp;@Html.DisplayFor(modelItem => product.OrderDetails.Count)</p>
                    </div>
                </li>
            }
        </ul>

        <!-- Hiển thị phân trang -->
        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("ProductList", new { categoryId = categoryId, page }))
        </div>
    }
    else
    {
        <p>Danh mục này chưa có sản phẩm nào.</p>
    }
</section>