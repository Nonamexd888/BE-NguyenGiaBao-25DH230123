@model BE_NguyenGiaBao_25DH230123.Models.Order

@{
    ViewBag.Title = "OrderSuccess";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>XÁC NHẬN ĐƠN HÀNG</h2>
<h3>Thông tin đơn hàng</h3>
<div>
    <p><strong>Mã đơn hàng:</strong> @Model.OrderID</p>
    <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
    <p><strong>Tổng số tiền:</strong> @Model.TotalAmount.ToString("N0")</p>
    <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
    <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
    <p><strong>Phương thức giao hàng:</strong> @Model.ShippingMethod</p>
    <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
</div>

<h3>Chi tiết đơn hàng</h3>
<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Tổng giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0")</td>
                <td>@(item.TotalPrice.HasValue ? item.TotalPrice.Value.ToString("N0") : "")</td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-2">
    @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-warning" })
    @Html.ActionLink("Đơn hàng của tôi", "MyOrder", "Order", null, new { @class = "btn btn-info" })
</div>