@model BE_NguyenGiaBao_25DH230123.Models.ViewModel.Cart

@using PagedList.Mvc
@using PagedList

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.SimilarProducts != null && Model.SimilarProducts.Any())
{
    <section class="@*container-fluid*@ listProduct">
        <h2>Sản phẩm tương tự</h2>
        <ul class="list-container">
            @foreach (var product in Model.SimilarProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" />
                        </a>
                    </div>
                    <div class="prodName" style="min-height:160px;">@product.ProductName </div>
                    <div class="prodPrice">@product.ProductPrice.ToString("N0") &nbsp;VND</div>
                    <div>
                        @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                            new { id = product.ProductID },
                            new { @class = "btn btn-info" })
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Hiển thị phân trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index2", new { page }))
    </div>
}