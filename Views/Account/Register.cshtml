@model BE_NguyenGiaBao_25DH230123.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "ĐĂNG KÝ TÀI KHOẢN";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .accountbtn {
        width: 275px;
        height: 40px;
        border: 1px solid #808080;
        margin: 5px;
        align-items: center;
    }
</style>

<div>
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="row mb-3">
                <h2 class="col-md-6"> Đăng ký tài khoản</h2>
            </div>
            @* Tên đăng nhập *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.Username, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>
            </div>
            @* mật khẩu *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.Password, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Xác nhận mật khẩu *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.ConfirmPassword, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Họ tên khách hàng *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.CustomerName, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                </div>
            </div>
            @* SĐT khách hàng *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.CustomerPhone, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Email khách hàng *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.CustomerEmail, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Địa chỉ khách hàng *@
            <div class="row mb-3">
                @Html.LabelFor(model => model.CustomerAddress, new { @class = "col-form-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-md-2 col-md-4">
                    <input type="submit" value="Đăng ký" class="btn btn-info accountbtn" /><br />
                    <p>Bạn Đã Có Tài Khoản? <a href="@Url.Action("Login", "Account", null)">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}